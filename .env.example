MONGODB_URI=

AUTH_URL=https://aicare.thinkroman.com
NEXTAUTH_URL=https://aicare.thinkroman.com
NEXTAUTH_SECRET=

# Platform default AI (used only when no BYOK config is active)
# Provider is always openai for platform default. BYOK ignores these.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Local / OpenAI-compatible base URL for BYOK "local" provider (runtime-selected)
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1

# Server-only master key to encrypt stored BYOK credentials (AES-256-GCM).
# Not a user API key. Not a model selector. 64-char hex (32 bytes). Never commit.
BYOK_ENCRYPTION_KEY=

# Cloudflare R2 via S3 API (private bucket; no public URLs)
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aicare
R2_REGION=auto

# Email reserved — inactive unless EMAIL_INTEGRATION_AUTHORIZED=true
RESEND_API_KEY=
EMAIL_SENT_FROM=
EMAIL_INTEGRATION_AUTHORIZED=

# WhatsApp reserved — inactive unless WHATSAPP_INTEGRATION_AUTHORIZED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_INTEGRATION_AUTHORIZED=

# Production contract requires Redis/Upstash rate limiting (Gate 6 release blocker until wired)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# Capacitor native shell loads this Next.js origin (wrap mode; not static export).
# Local dev may use http://localhost:3000. Production native builds require https://
# deployed origin (never localhost).
CAPACITOR_SERVER_URL=http://localhost:3000
