MONGODB_URI=

AUTH_URL=https://aicare.thinkroman.com
NEXTAUTH_URL=https://aicare.thinkroman.com
NEXTAUTH_SECRET=

# Platform AI (default when BYOK is not active)
OPENAI_API_KEY=
AI_MODEL=

# Local / OpenAI-compatible endpoint for BYOK "local" provider
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1

# Server master key for encrypting BYOK credentials (not a provider key)
BYOK_ENCRYPTION_KEY=

# Cloudflare R2 via S3 API (private bucket; no public URLs)
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aicare
R2_REGION=auto

RESEND_API_KEY=
EMAIL_SENT_FROM=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
